{
    "name": "marekmiklusek/package-skeleton",
    "description": "A skeleton for creating new Laravel packages.",
    "keywords": ["php", "laravel", "package", "skeleton"],
    "license": "MIT",
    "authors": [
        {
            "name": "Marek Miklusek",
            "email": "marek.miklusek@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4.0",
        "laravel/framework": "^12.17.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22.1",
        "larastan/larastan": "^3.4.0",
        "rector/rector": "^2.0.17",
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "MarekMiklusek\\PackageSkeleton\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest"
        ],
        "format": "./vendor/bin/pint",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "refactor": "./vendor/bin/rector",
        "refactor:dry-run": "./vendor/bin/rector --dry-run"
    }
}