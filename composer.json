{
    "name": "marekmiklusek/package-skeleton",
    "description": "A skeleton for creating Laravel packages",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marek Miklusek",
            "email": "marek.miklusek@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.17"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "larastan/larastan": "^3.4",
        "rector/rector": "^2.0",
        "pestphp/pest": "^3.8",
        "orchestra/testbench": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "MarekMiklusek\\PackageSkeleton\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarekMiklusek\\PackageSkeleton\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "refactor": "vendor/bin/rector process"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
